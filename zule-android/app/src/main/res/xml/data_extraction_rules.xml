<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing backed up to the cloud; nothing transferred to a new device.
    Forces re-authentication on every new device. Local flags
    (EncryptedSharedPreferences) stay behind; memory-only session is lost on
    process death by design.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
